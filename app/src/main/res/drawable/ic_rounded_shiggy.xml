<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="256"
    android:viewportHeight="256">

    <!-- Solid circular background (Shiggy yellow-ish) -->
    <path
        android:fillColor="#fcc680"
        android:pathData="M128,128 m-128,0 a128,128 0 1,0 256,0 a128,128 0 1,0 -256,0" />

    <!-- Main character group - centered and slightly scaled -->
    <group
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:translateX="6"
        android:translateY="6">

        <!-- Face base (oval, white) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M80,180 Q128,220 176,180 Q190,140 176,100 Q128,60 80,100 Q66,140 80,180 Z" />

        <!-- Fox ears group -->
        <group android:translateX="0" android:translateY="0">
            <!-- Left ear -->
            <path
                android:fillColor="#000000"
                android:pathData="M70,60 L50,20 L90,50 Z" />
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M70,50 L55,30 L80,45 Z" />
            <!-- Right ear -->
            <path
                android:fillColor="#000000"
                android:pathData="M186,60 L206,20 L166,50 Z" />
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M186,50 L201,30 L176,45 Z" />
        </group>

        <!-- Hair fringe -->
        <path
            android:fillColor="#000000"
            android:pathData="M90,70 Q128,50 166,70 L170,90 Q128,70 86,90 Z" />

        <!-- Eyes group -->
        <group>
            <!-- Left eye -->
            <path
                android:fillColor="#000000"
                android:pathData="M90,110 Q110,100 130,110 Q120,120 100,118 Z" />
            <!-- Right eye -->
            <path
                android:fillColor="#000000"
                android:pathData="M126,110 Q146,100 166,110 Q156,120 136,118 Z" />
            <!-- Highlights -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M105,108 Q108,106 112,108 Z" />
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M141,108 Q144,106 148,108 Z" />
        </group>

        <!-- Tears -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="4"
            android:fillColor="#00000000"
            android:pathData="M100,120 Q95,140 92,160" />
        <path
            android:strokeColor="#000000"
            android:strokeWidth="4"
            android:fillColor="#00000000"
            android:pathData="M156,120 Q161,140 164,160" />

        <!-- Blush cheeks -->
        <path
            android:fillColor="#FF9999"
            android:fillAlpha="0.6"
            android:pathData="M85,130 m-20,0 a20,15 0 1,0 40,0 a20,15 0 1,0 -40,0" />
        <path
            android:fillColor="#FF9999"
            android:fillAlpha="0.6"
            android:pathData="M151,130 m-20,0 a20,15 0 1,0 40,0 a20,15 0 1,0 -40,0" />

        <!-- Mouth + tongue group -->
        <group android:translateY="2">
            <!-- Mouth -->
            <path
                android:fillColor="#000000"
                android:pathData="M100,140 Q128,170 156,140 L160,150 Q128,180 96,150 Z" />
            <!-- Tongue -->
            <path
                android:fillColor="#FF69B4"
                android:pathData="M110,145 Q128,165 146,145 Q140,170 128,175 Q116,170 110,145 Z" />
            <!-- Tongue highlight -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M125,155 Q128,160 131,155 Z" />
        </group>

        <!-- Drool lines -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="5"
            android:fillColor="#00000000"
            android:pathData="M110,150 Q100,180 95,200" />
        <path
            android:strokeColor="#000000"
            android:strokeWidth="5"
            android:fillColor="#00000000"
            android:pathData="M146,150 Q156,180 161,200" />
        <path
            android:strokeColor="#000000"
            android:strokeWidth="6"
            android:fillColor="#00000000"
            android:pathData="M128,175 Q128,195 128,210" />

        <!-- Collar / choker -->
        <path
            android:fillColor="#000000"
            android:pathData="M90,185 Q128,195 166,185 L170,200 Q128,205 86,200 Z" />
        <path
            android:fillColor="#FF69B4"
            android:pathData="M120,190 L136,190 L128,200 Z" />

    </group>

</vector>
